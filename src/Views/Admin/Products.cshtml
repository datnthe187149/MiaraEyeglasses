@model IEnumerable<MiaraEyeglasses.Models.Entities.Product>
@{
    ViewData["Title"] = "Quản lý Sản phẩm & Biến thể";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var categories = ViewBag.Categories as IEnumerable<MiaraEyeglasses.Models.Entities.Category> ?? Enumerable.Empty<MiaraEyeglasses.Models.Entities.Category>();
    var brands = ViewBag.Brands as IEnumerable<MiaraEyeglasses.Models.Entities.Brand> ?? Enumerable.Empty<MiaraEyeglasses.Models.Entities.Brand>();
    var pagination = ViewBag.Pagination as MiaraEyeglasses.Models.ViewModels.PaginationModel;
    int? selectedCategory = ViewBag.SelectedCategoryId as int?;
    int? selectedBrand = ViewBag.SelectedBrandId as int?;
    string selectedStatus = ViewBag.SelectedStatus as string ?? "";
    string searchKeyword = ViewBag.Search as string ?? "";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Kho sản phẩm · Products</span>
            <h2>Quản lý Sản phẩm, Biến thể &amp; Hình ảnh</h2>
            <p class="small muted">Quản lý danh sách các mẫu gọng kính kinh doanh, tìm kiếm, lọc theo danh mục, thương hiệu và phân trang.</p>
        </div>
        <button type="button" class="button small-btn" data-toggle-form="form-add-product" onclick="toggleAdminForm('form-add-product')">+ Thêm sản phẩm mới</button>
    </div>

    <!-- Form Thêm mới sản phẩm -->
    <form class="sub-panel-form" id="form-add-product" hidden asp-controller="AdminProduct" asp-action="Add" method="post" enctype="multipart/form-data" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-bottom:24px;">
        @Html.AntiForgeryToken()
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px">
            <h3 style="margin:0; font-size:16px; font-weight:700; color:#0f172a;">Thêm Mẫu Gọng Kính Mới</h3>
            <button type="button" class="text-button" onclick="document.getElementById('form-add-product').setAttribute('hidden','')">✕ Đóng form</button>
        </div>
        <div class="form-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:12px;">
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Tên mẫu kính *</span>
                <input type="text" name="productName" required placeholder="VD: ALFIO RALDO 3114" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Mã sản phẩm (SKU) *</span>
                <input type="text" name="productCode" required placeholder="VD: 3114-151O16-143" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Danh mục gọng kính *</span>
                <select name="categoryId" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;">
                    @foreach (var c in categories)
                    {
                        <option value="@c.CategoryId">@c.CategoryName</option>
                    }
                </select>
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Thương hiệu phân phối *</span>
                <select name="brandId" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;">
                    @foreach (var b in brands)
                    {
                        <option value="@b.BrandId">@b.BrandName (@b.Country)</option>
                    }
                </select>
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Giá niêm yết (VNĐ) *</span>
                <input type="number" name="price" required value="349000" min="1000" step="10000" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Dáng gọng &amp; Chất liệu</span>
                <input type="text" name="specs" value="Vuông · Nhựa Acetate · Unisex" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Biến thể Màu sắc khởi tạo *</span>
                <input type="text" name="colorName" required value="Đen bóng" placeholder="VD: Đen bóng" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Kích cỡ &amp; Tồn kho ban đầu *</span>
                <input type="text" name="sizesStock" required value="M (15)" placeholder="VD: M (15)" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
        </div>
        <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600; margin-bottom:14px;">
            <span>Tải lên các tệp hình ảnh sản phẩm (.jpg, .png, .webp)</span>
            <input type="file" name="galleryImageFiles" multiple accept="image/jpeg,image/png,image/webp" style="padding:6px; border:1px solid #cbd5e1; border-radius:6px;" />
        </label>
        <div style="display:flex; gap:10px;">
            <button type="submit" class="button small-btn">✓ Lưu sản phẩm mới</button>
            <button type="reset" class="button button-outline small-btn">Làm mới</button>
        </div>
    </form>

    <!-- THANH BỘ LỌC ĐA TIÊU CHÍ (FILTER BAR) -->
    <form method="get" asp-controller="AdminProduct" asp-action="Index" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-bottom:20px;">
        <div style="display:grid; grid-template-columns: 2fr 1.2fr 1.2fr 1fr auto; gap:12px; align-items:flex-end;">
            <div>
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Từ khóa tìm kiếm</label>
                <input type="text" name="search" value="@searchKeyword" placeholder="Nhập tên mẫu kính, mã SKU..." style="width:100%; height:36px; padding:0 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;" />
            </div>
            <div>
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Danh mục gọng</label>
                <select name="categoryId" style="width:100%; height:36px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;">
                    <option value="">-- Tất cả danh mục --</option>
                    @foreach (var c in categories)
                    {
                        if (selectedCategory.HasValue && selectedCategory.Value == c.CategoryId)
                        {
                            <option value="@c.CategoryId" selected>@c.CategoryName</option>
                        }
                        else
                        {
                            <option value="@c.CategoryId">@c.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Thương hiệu</label>
                <select name="brandId" style="width:100%; height:36px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;">
                    <option value="">-- Tất cả thương hiệu --</option>
                    @foreach (var b in brands)
                    {
                        if (selectedBrand.HasValue && selectedBrand.Value == b.BrandId)
                        {
                            <option value="@b.BrandId" selected>@b.BrandName</option>
                        }
                        else
                        {
                            <option value="@b.BrandId">@b.BrandName</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Trạng thái</label>
                <select name="status" style="width:100%; height:36px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;">
                    <!option value="" @(string.IsNullOrEmpty(selectedStatus) ? "selected" : "")>Tất cả</!option>
                    <!option value="active" @(selectedStatus == "active" ? "selected" : "")>Đang hiển thị</!option>
                    <!option value="inactive" @(selectedStatus == "inactive" ? "selected" : "")>Đã ẩn</!option>
                </select>
            </div>
            <div style="display:flex; gap:8px;">
                <button type="submit" class="admin-btn-action btn-primary-action" style="height:36px !important;">
                    🔍 Lọc
                </button>
                <a asp-controller="AdminProduct" asp-action="Index" class="admin-btn-action" style="height:36px !important; text-decoration:none;" title="Đặt lại bộ lọc">
                    ↺ Đặt lại
                </a>
            </div>
        </div>
    </form>

    <!-- BẢNG DANH SÁCH SẢN PHẨM -->
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">Ảnh</th>
                    <th>Sản phẩm &amp; Mã SKU</th>
                    <th>Danh mục / Thương hiệu</th>
                    <th>Biến thể (Màu / Size)</th>
                    <th>Giá niêm yết</th>
                    <th>Tổng tồn kho</th>
                    <th>Trạng thái</th>
                    <th style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var p in Model)
                    {
                        var primaryImg = p.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                                         ?? p.Images?.FirstOrDefault()?.ImageUrl 
                                         ?? "/images/products/p1.png";
                        var colorNames = p.Variants != null && p.Variants.Any() 
                                         ? string.Join(", ", p.Variants.Select(v => v.ColorName).Where(c => !string.IsNullOrEmpty(c)).Distinct())
                                         : "Tiêu chuẩn";
                        var sizeLabels = p.Variants != null && p.Variants.Any()
                                         ? string.Join(", ", p.Variants.Select(v => v.SizeLabel).Where(s => !string.IsNullOrEmpty(s)).Distinct())
                                         : "Free size";
                        int totalStock = p.Variants != null ? p.Variants.Sum(v => v.StockQty) : 0;
                        int imgCount = p.Images != null ? p.Images.Count() : 1;

                        <tr>
                            <td>
                                <img src="@primaryImg" alt="@p.ProductName" style="width: 48px; height: 48px; object-fit: contain; background: #fff; border-radius: 6px; border: 1px solid #e2e8f0;" />
                            </td>
                            <td>
                                <strong>@p.ProductName</strong><br />
                                <small class="muted"><code>@p.ProductCode</code> &bull; (@imgCount ảnh)</small>
                            </td>
                            <td>
                                @(p.Category?.CategoryName ?? "Gọng kính")<br />
                                <small class="muted">@(p.Brand?.BrandName ?? "MIARA")</small>
                            </td>
                            <td>
                                <span>@colorNames</span><br />
                                <small class="muted">Size: @sizeLabels</small>
                            </td>
                            <td>
                                <strong style="color: #286598;">@p.Price.ToString("N0") ₫</strong>
                            </td>
                            <td>
                                @if (totalStock == 0)
                                {
                                    <span class="badge" style="background:#fee2e2; color:#dc2626;">Hết hàng</span>
                                }
                                else if (totalStock <= 3)
                                {
                                    <span class="badge" style="background:#fef3c7; color:#92400e;">Còn @totalStock chiếc</span>
                                }
                                else
                                {
                                    <span class="badge" style="background:#f1f5f9; color:#334155;">@totalStock chiếc</span>
                                }
                            </td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="status-badge status-badge--completed">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--cancelled">Đã ẩn</span>
                                }
                            </td>
                            <td>
                                <div class="admin-table-actions">
                                    <a asp-controller="AdminProduct" asp-action="Edit" asp-route-id="@p.ProductId" class="admin-btn-action">
                                        Chỉnh sửa
                                    </a>
                                    <form asp-controller="AdminProduct" asp-action="ToggleActive" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@p.ProductId" />
                                        <button type="submit" class="admin-btn-action @(p.IsActive ? "btn-toggle-off" : "btn-toggle-on")">
                                            @(p.IsActive ? "Ẩn" : "Hiện")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="empty-text">Không tìm thấy sản phẩm nào phù hợp với điều kiện lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- TÁI SỬ DỤNG FILE PHÂN TRANG DÙNG CHUNG (REUSABLE PAGINATION) -->
    @if (pagination != null)
    {
        @await Html.PartialAsync("_Pagination", pagination)
    }
</div>
