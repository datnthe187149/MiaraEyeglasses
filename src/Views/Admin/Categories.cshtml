@model IEnumerable<MiaraEyeglasses.Models.Entities.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục Gọng kính";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Phân loại sản phẩm · Categories</span>
            <h2>Quản lý Danh mục Gọng kính</h2>
            <p class="small muted">Quản lý các phân nhóm gọng kính (Nam, Nữ, Unisex, Càng kim loại, Nhựa Acetate, Titan...).</p>
        </div>
        <button type="button" class="button small-btn" data-toggle-form="form-add-category" onclick="toggleAdminForm('form-add-category')">+ Thêm danh mục mới</button>
    </div>

    <!-- Form Thêm / Cập nhật Danh mục -->
    <form class="customer-form sub-panel-form" id="form-add-category" hidden asp-controller="AdminCategory" asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
            <h3 style="margin:0">Thêm / Cập nhật Danh mục</h3>
            <button type="button" class="text-button" onclick="document.getElementById('form-add-category').setAttribute('hidden','')">✕ Đóng form</button>
        </div>
        <div class="form-grid-2">
            <label>
                <span>Tên danh mục *</span>
                <input type="text" name="categoryName" required placeholder="VD: Gọng kính Titan cao cấp" />
            </label>
            <label>
                <span>Đường dẫn định danh (Slug)</span>
                <input type="text" name="slug" placeholder="VD: gong-kinh-titan" />
            </label>
        </div>
        <label>
            <span>Mô tả danh mục</span>
            <input type="text" name="description" placeholder="Mô tả tóm tắt..." />
        </label>
        <div style="display:flex; gap:12px; margin-top:8px">
            <button type="submit" class="button">Lưu danh mục</button>
            <button type="reset" class="button button-outline">Làm mới</button>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Tên danh mục</th>
                    <th>Đường dẫn định danh (Slug)</th>
                    <th>Mô tả tóm tắt</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.CategoryName</strong></td>
                            <td><code>@c.Slug</code></td>
                            <td>@(string.IsNullOrEmpty(c.Description) ? "—" : c.Description)</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="status-badge status-badge--completed">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--cancelled">Đã ẩn</span>
                                }
                            </td>
                            <td>
                                <form asp-controller="AdminCategory" asp-action="ToggleActive" method="post" style="display:inline; margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                    <button type="submit" class="text-button @(c.IsActive ? "danger-text" : "")">
                                        @(c.IsActive ? "Ẩn" : "Hiện")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" style="text-align:center; padding:32px; color:#64748b;">Chưa có danh mục nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
