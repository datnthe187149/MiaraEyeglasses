@model MiaraEyeglasses.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="view-section">
  <section class="container section customer-page">
    <div class="page-intro" data-reveal>
      <span class="eyebrow">Góc riêng của bạn</span>
      <h1>Chào bạn trở lại.</h1>
      <p>Đăng nhập để quản lý hồ sơ, sổ địa chỉ và theo dõi trạng thái đơn hàng của bạn.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="max-width: 480px; margin: 0 auto 20px auto; padding: 12px 16px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; border-radius: 8px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <form class="customer-form" asp-controller="Login" asp-action="Index" method="post" data-reveal>
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="ReturnUrl" />
      <div asp-validation-summary="ModelOnly" class="text-danger" style="color: #dc2626; font-size: 13px; margin-bottom: 12px;"></div>

      <label>
        Email
        <input asp-for="Email" type="email" inputmode="email" autocomplete="email" maxlength="254" required placeholder="ban@email.com" />
        <span asp-validation-for="Email" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <label>
        Mật khẩu
        <input asp-for="Password" type="password" autocomplete="current-password" required placeholder="••••••••" />
        <span asp-validation-for="Password" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <div style="display: flex; justify-content: space-between; align-items: center; margin: 8px 0 16px 0; font-size: 14px;">
        <label style="display: flex; align-items: center; gap: 8px; margin: 0; cursor: pointer;">
          <input asp-for="RememberMe" type="checkbox" style="width: auto; margin: 0;" />
          <span>Ghi nhớ đăng nhập</span>
        </label>
        <a class="text-link" asp-controller="ForgotPassword" asp-action="Index">Quên mật khẩu?</a>
      </div>

      <button class="button" type="submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
        Đăng nhập
      </button>

      <p style="text-align: center; margin-top: 16px;">
        Bạn mới đến MIARA?
        <a asp-controller="Register" asp-action="Index" style="font-weight: 600; text-decoration: underline;">Đăng ký ngay</a>
      </p>
    </form>
  </section>
</div>
