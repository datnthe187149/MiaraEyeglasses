@model IEnumerable<MiaraEyeglasses.Models.Entities.Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    byte? selectedStatus = ViewBag.SelectedStatus as byte?;
    string searchKeyword = ViewBag.Search as string ?? "";
    var pagination = ViewBag.Pagination as MiaraEyeglasses.Models.ViewModels.PaginationModel;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Đơn hàng trực tuyến · Orders</span>
            <h2>Quản lý Đơn hàng</h2>
            <p class="small muted">Theo dõi toàn bộ đơn hàng của khách, kiểm tra thông số đơn kính mắt và trạng thái thanh toán.</p>
        </div>
    </div>

    <!-- Bộ lọc trạng thái đơn hàng và tìm kiếm -->
    <form method="get" asp-controller="AdminOrder" asp-action="Index" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-bottom:20px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:12px;">
            <div style="flex:1; min-width:280px; max-width:450px;">
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Tìm kiếm đơn hàng</label>
                <input type="text" name="search" value="@searchKeyword" placeholder="Nhập mã đơn (#MR-...), tên khách, SĐT..." style="width:100%; height:36px; padding:0 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;" />
            </div>
            <div style="width:200px;">
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Lọc theo trạng thái</label>
                <select name="status" style="width:100%; height:36px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;">
                    <!option value="" @(selectedStatus == null ? "selected" : "")>Tất cả trạng thái</!option>
                    <!option value="0" @(selectedStatus == 0 ? "selected" : "")>Đang thanh toán</!option>
                    <!option value="1" @(selectedStatus == 1 ? "selected" : "")>Đã thanh toán</!option>
                    <!option value="5" @(selectedStatus == 5 ? "selected" : "")>Đã hủy</!option>
                </select>
            </div>
            <div style="display:flex; gap:8px;">
                <button type="submit" class="admin-btn-action btn-primary-action" style="height:36px !important;">🔍 Lọc đơn</button>
                @if (!string.IsNullOrEmpty(searchKeyword) || selectedStatus != null)
                {
                    <a asp-controller="AdminOrder" asp-action="Index" class="admin-btn-action" style="height:36px !important; text-decoration:none;" title="Đặt lại bộ lọc">↺ Đặt lại</a>
                }
            </div>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Khách hàng &amp; SĐT</th>
                    <th>Đơn kính cận (SPH, CYL, AXIS, PD)</th>
                    <th>Tổng thanh toán</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var o in Model)
                    {
                        var firstItem = o.Items?.FirstOrDefault();

                        string statusBadgeClass = "completed";
                        string statusText = "Đã thanh toán";

                        if (o.Status == 0)
                        {
                            statusBadgeClass = "pending";
                            statusText = "Đang thanh toán";
                        }
                        else if (o.Status == 5 || o.Status == 6)
                        {
                            statusBadgeClass = "cancelled";
                            statusText = "Đã hủy";
                        }

                        <tr>
                            <td>
                                <strong>#@o.OrderCode</strong><br />
                                <small class="muted">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <strong>@o.RecipientName</strong><br />
                                <small class="muted">SĐT: @o.Phone</small>
                            </td>
                            <td>
                                @if (firstItem != null && (firstItem.RightSph != null || firstItem.LeftSph != null))
                                {
                                    <div class="rx-mini-box">
                                        <strong>OD:</strong> @(firstItem.RightSph?.ToString("0.00") ?? "0.00") | @(firstItem.RightCyl?.ToString("0.00") ?? "0.00") | @(firstItem.RightAxis?.ToString() ?? "0")° · 
                                        <strong>OS:</strong> @(firstItem.LeftSph?.ToString("0.00") ?? "0.00") | @(firstItem.LeftCyl?.ToString("0.00") ?? "0.00") | @(firstItem.LeftAxis?.ToString() ?? "0")° · 
                                        <strong>PD:</strong> @(firstItem.PD?.ToString("0.0") ?? "62.0")mm
                                    </div>
                                }
                                else
                                {
                                    <div class="rx-mini-box">
                                        <small class="muted">Kính không độ (Thời trang)</small>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong style="color: #286598;">@o.TotalAmount.ToString("N0") ₫</strong>
                            </td>
                            <td>
                                <span class="status-badge status-badge--@statusBadgeClass">@statusText</span>
                            </td>
                            <td>
                                <div class="admin-table-actions">
                                    <a asp-controller="AdminOrder" asp-action="Detail" asp-route-id="@o.OrderId" class="admin-btn-action">Xem chi tiết</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-text">Không có đơn hàng nào phù hợp với bộ lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- TÁI SỬ DỤNG FILE PHÂN TRANG DÙNG CHUNG (REUSABLE PAGINATION) -->
    @if (pagination != null)
    {
        @await Html.PartialAsync("_Pagination", pagination)
    }
</div>
