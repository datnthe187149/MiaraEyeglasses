@model MiaraEyeglasses.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="view-section">
  <section class="container section customer-page">
    <div class="page-intro" data-reveal>
      <span class="eyebrow">Khôi phục tài khoản</span>
      <h1>Quên mật khẩu?</h1>
      <p>Nhập địa chỉ email đã đăng ký với MIARA để nhận liên kết đặt lại mật khẩu mới.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="max-width: 480px; margin: 0 auto 20px auto; padding: 12px 16px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; border-radius: 8px;">
            @TempData["SuccessMessage"]
        </div>
    }

    <form class="customer-form" asp-controller="ForgotPassword" asp-action="Index" method="post" data-reveal>
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="text-danger" style="color: #dc2626; font-size: 13px; margin-bottom: 12px;"></div>

      <label>
        Địa chỉ Email đã đăng ký *
        <input asp-for="Email" type="email" inputmode="email" autocomplete="email" maxlength="254" required placeholder="ban@email.com" />
        <span asp-validation-for="Email" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <button class="button" type="submit" style="margin-top: 14px;">
        Gửi yêu cầu đặt lại mật khẩu
      </button>

      <p style="text-align: center; margin-top: 16px;">
        Đã nhớ mật khẩu?
        <a asp-controller="Login" asp-action="Index" style="font-weight: 600; text-decoration: underline;">Quay lại Đăng nhập</a>
      </p>
    </form>
  </section>
</div>
