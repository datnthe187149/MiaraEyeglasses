@model MiaraEyeglasses.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
}

<div class="view-section">
  <section class="container section customer-page">
    <div class="page-intro" data-reveal>
      <span class="eyebrow">Góc riêng của bạn</span>
      <h1>Tạo tài khoản MIARA.</h1>
      <p>Lưu thông tin độ cận, sổ địa chỉ giao hàng và theo dõi đơn hàng dễ dàng.</p>
    </div>

    <form class="customer-form" asp-controller="Register" asp-action="Index" method="post" data-reveal>
      @Html.AntiForgeryToken()
      <div asp-validation-summary="ModelOnly" class="text-danger" style="color: #dc2626; font-size: 13px; margin-bottom: 12px;"></div>

      <label>
        Họ và tên *
        <input asp-for="FullName" autocomplete="name" minlength="2" maxlength="80" required placeholder="Nguyễn Minh Anh" />
        <span asp-validation-for="FullName" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <label>
        Số điện thoại *
        <input asp-for="Phone" type="tel" autocomplete="tel" required placeholder="0901234567" />
        <span asp-validation-for="Phone" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <label>
        Email *
        <input asp-for="Email" type="email" inputmode="email" autocomplete="email" maxlength="254" required placeholder="ban@email.com" />
        <span asp-validation-for="Email" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <label>
        Mật khẩu *
        <input asp-for="Password" type="password" autocomplete="new-password" minlength="6" required placeholder="Tối thiểu 6 ký tự" />
        <span asp-validation-for="Password" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <label>
        Nhập lại mật khẩu *
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" minlength="6" required placeholder="Nhập lại mật khẩu" />
        <span asp-validation-for="ConfirmPassword" style="color: #dc2626; font-size: 12px;"></span>
      </label>

      <button class="button" type="submit">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
        Tạo tài khoản
      </button>

      <p style="text-align: center; margin-top: 16px;">
        Đã có tài khoản?
        <a asp-controller="Login" asp-action="Index" style="font-weight: 600; text-decoration: underline;">Đăng nhập</a>
      </p>
    </form>
  </section>
</div>
