@model IEnumerable<MiaraEyeglasses.Models.Entities.User>
@{
    ViewData["Title"] = "Quản lý Tài khoản & Phân quyền";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as IEnumerable<MiaraEyeglasses.Models.Entities.Role> ?? Enumerable.Empty<MiaraEyeglasses.Models.Entities.Role>();
    var pagination = ViewBag.Pagination as MiaraEyeglasses.Models.ViewModels.PaginationModel;
    string searchKeyword = ViewBag.SearchTerm as string ?? "";
    int? selectedRoleId = ViewBag.SelectedRoleId as int?;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Người dùng hệ thống · Users &amp; Roles</span>
            <h2>Quản lý Tài khoản &amp; Phân quyền</h2>
            <p class="small muted">Quản lý tài khoản Khách hàng, Nhân viên và Quản trị viên: Xem hồ sơ cá nhân &amp; lịch sử đơn hàng đã mua, tạo mới tài khoản nhân viên, khóa hoặc xóa tài khoản an toàn.</p>
        </div>
        <button type="button" class="button small-btn" data-toggle-form="form-create-user" onclick="toggleAdminForm('form-create-user')">+ Thêm tài khoản mới</button>
    </div>

    <!-- Thanh tìm kiếm & bộ lọc Người dùng Server-Side -->
    <form method="get" asp-controller="AdminUser" asp-action="Index" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px; margin-bottom:20px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:12px;">
            <div style="flex:1; min-width:280px; max-width:450px;">
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Tìm kiếm tài khoản</label>
                <input type="text" name="search" value="@searchKeyword" placeholder="Nhập họ tên, email, số điện thoại..." style="width:100%; height:36px; padding:0 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;" />
            </div>
            <div style="width:200px;">
                <label style="display:block; font-size:12px; font-weight:600; color:#475569; margin-bottom:4px;">Lọc theo vai trò</label>
                <select name="roleId" style="width:100%; height:36px; padding:0 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;">
                    <!option value="" @(selectedRoleId == null ? "selected" : "")>Tất cả vai trò</!option>
                    @foreach (var r in roles)
                    {
                        <!option value="@r.RoleId" @(selectedRoleId == r.RoleId ? "selected" : "")>@r.RoleName</!option>
                    }
                </select>
            </div>
            <div style="display:flex; gap:8px;">
                <button type="submit" class="admin-btn-action btn-primary-action" style="height:36px !important;">🔍 Lọc tài khoản</button>
                @if (!string.IsNullOrEmpty(searchKeyword) || selectedRoleId != null)
                {
                    <a asp-controller="AdminUser" asp-action="Index" class="admin-btn-action" style="height:36px !important; text-decoration:none;" title="Đặt lại bộ lọc">↺ Đặt lại</a>
                }
            </div>
        </div>
    </form>

    <!-- Form Thêm mới Tài khoản Người dùng -->
    <form class="customer-form sub-panel-form" id="form-create-user" hidden asp-controller="AdminUser" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
            <h3 style="margin:0">Thêm mới tài khoản người dùng</h3>
            <button type="button" class="text-button" onclick="document.getElementById('form-create-user').setAttribute('hidden','')">✕ Đóng form</button>
        </div>
        <div class="form-grid-2">
            <label>
                <span>Họ và tên *</span>
                <input type="text" name="fullName" required placeholder="VD: Nguyễn Văn An" />
            </label>
            <label>
                <span>Email đăng nhập *</span>
                <input type="email" name="email" required placeholder="an.nguyen@miaraeyeglasses.com" />
            </label>
            <label>
                <span>Số điện thoại *</span>
                <input type="tel" name="phone" required placeholder="0912345678" />
            </label>
            <label>
                <span>Mật khẩu khởi tạo * (Tối thiểu 6 ký tự)</span>
                <input type="password" name="password" required placeholder="••••••••" />
            </label>
            <label>
                <span>Vai trò phân quyền *</span>
                <select name="roleId">
                    @foreach (var r in roles)
                    {
                        <option value="@r.RoleId">@r.RoleName</option>
                    }
                </select>
            </label>
            <label>
                <span>Giới tính</span>
                <select name="gender">
                    <option value="Nam">Nam</option>
                    <option value="Nữ">Nữ</option>
                    <option value="Khác">Khác</option>
                </select>
            </label>
            <label>
                <span>Ngày sinh</span>
                <input type="date" name="birthDateStr" />
            </label>
        </div>
        <div style="display:flex; gap:12px; margin-top:16px">
            <button type="submit" class="button">+ Lưu tạo tài khoản</button>
            <button type="reset" class="button button-outline">Làm mới</button>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table" id="users-admin-table">
            <thead>
                <tr>
                    <th>Họ và tên</th>
                    <th>Email liên hệ</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var u in Model)
                    {
                        string roleNameStr = "Khách hàng";
                        if (u.Role != null)
                        {
                            roleNameStr = u.Role.RoleName;
                        }
                        else if (u.RoleId == 3)
                        {
                            roleNameStr = "Quản trị viên";
                        }
                        else if (u.RoleId == 2)
                        {
                            roleNameStr = "Nhân viên";
                        }

                        string roleBadgeClass = "pending";
                        if (roleNameStr == "Quản trị viên" || roleNameStr == "Admin")
                        {
                            roleBadgeClass = "completed";
                        }
                        else if (roleNameStr == "Nhân viên" || roleNameStr == "Staff")
                        {
                            roleBadgeClass = "processing";
                        }

                        <tr>
                            <td><strong>@u.FullName</strong></td>
                            <td>@u.Email</td>
                            <td>
                                @if (string.IsNullOrEmpty(u.Phone))
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    @u.Phone
                                }
                            </td>
                            <td>
                                <span class="status-badge status-badge--@roleBadgeClass">@roleNameStr</span>
                            </td>
                            <td>
                                @if (u.IsActive)
                                {
                                    <span class="status-badge status-badge--completed">Hoạt động</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--cancelled">Đã khóa</span>
                                }
                            </td>
                            <td>
                                <div class="admin-table-actions">
                                    <a asp-controller="AdminUser" asp-action="Details" asp-route-id="@u.UserId" class="admin-btn-action">Chi tiết</a>
                                    
                                    @if (roleNameStr != "Admin" && roleNameStr != "Quản trị viên")
                                    {
                                        <form asp-controller="AdminUser" asp-action="ToggleActive" method="post" style="display:inline; margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="admin-btn-action @(u.IsActive ? "btn-toggle-off" : "btn-toggle-on")">
                                                @(u.IsActive ? "Khóa" : "Mở")
                                            </button>
                                        </form>

                                        <form asp-controller="AdminUser" asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này?');" style="display:inline; margin:0;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.UserId" />
                                            <button type="submit" class="admin-btn-action btn-toggle-off">
                                                Xóa
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="small muted" style="padding-left: 4px;">Mặc định</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:32px; color:#64748b;">Chưa có tài khoản nào phù hợp với bộ lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- TÁI SỬ DỤNG FILE PHÂN TRANG DÙNG CHUNG (REUSABLE PAGINATION) -->
    @if (pagination != null)
    {
        @await Html.PartialAsync("_Pagination", pagination)
    }
</div>
