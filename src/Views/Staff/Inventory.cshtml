@model IEnumerable<MiaraEyeglasses.Models.Entities.ProductVariant>
@{
    ViewData["Title"] = "Quản lý tồn kho sản phẩm (Staff)";
}

<div class="bo-main-wrap container" style="padding-top: 10px;">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 20px;">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom: 20px;">@TempData["ErrorMessage"]</div>
    }

    <div class="portal-card" style="background: #fff; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <div class="portal-card-head" style="margin-bottom: 20px;">
            <span class="eyebrow" style="color: #2563eb; text-transform: uppercase; font-size: 13px; font-weight: 600;">Kho vận & Tồn kho · Nhân viên</span>
            <h2 style="margin: 4px 0;">Cập nhật số lượng tồn kho sản phẩm</h2>
            <p class="small muted" style="margin: 0;">Điều chỉnh nhanh số lượng tồn kho của các biến thể kính khi nhập hàng mới hoặc kiểm kê thực tế.</p>
        </div>

        <div class="admin-table-wrap" style="overflow-x: auto;">
            <table class="table" style="width: 100%; border-collapse: collapse; font-size: 14px;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;">
                        <th style="padding: 12px;">Mẫu gọng kính</th>
                        <th style="padding: 12px;">Mã SKU</th>
                        <th style="padding: 12px;">Màu sắc & Cỡ kính</th>
                        <th style="padding: 12px;">Giá niêm yết</th>
                        <th style="padding: 12px;">Tồn kho hiện tại</th>
                        <th style="padding: 12px;">Cập nhật tồn kho</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var v in Model)
                        {
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 12px;">
                                    <strong>@v.Product.ProductName</strong><br />
                                    <small class="muted">@v.Product.ProductCode</small>
                                </td>
                                <td style="padding: 12px;"><code>@v.Sku</code></td>
                                <td style="padding: 12px;">@v.ColorName · Size @v.SizeLabel</td>
                                <td style="padding: 12px; font-weight: 500;">@v.Product.Price.ToString("N0") ₫</td>
                                <td style="padding: 12px;">
                                    @if (v.StockQty <= 3)
                                    {
                                        <span class="badge" style="background: #ef4444; color: #fff; padding: 3px 8px; border-radius: 4px;">Sắp hết: @v.StockQty</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background: #10b981; color: #fff; padding: 3px 8px; border-radius: 4px;">Còn hàng: @v.StockQty</span>
                                    }
                                </td>
                                <td style="padding: 12px;">
                                    <form asp-action="UpdateStock" method="post" style="display: flex; gap: 8px; align-items: center; margin: 0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="variantId" value="@v.VariantId" />
                                        <input type="number" name="newStock" value="@v.StockQty" min="0" max="999" style="width: 80px; padding: 6px; border: 1px solid #cbd5e1; border-radius: 4px;" />
                                        <button type="submit" class="button small-btn" style="padding: 6px 12px;">Lưu</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 32px; color: #64748b;">
                                Không có biến thể sản phẩm nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

