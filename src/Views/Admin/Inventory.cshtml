@model IEnumerable<MiaraEyeglasses.Models.Entities.ProductVariant>
@{
    ViewData["Title"] = "Quản lý Tồn kho";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var pagination = ViewBag.Pagination as MiaraEyeglasses.Models.ViewModels.PaginationModel;
    string currentFilter = ViewBag.Filter as string ?? "all";
    string searchKeyword = ViewBag.Search as string ?? "";
    int allCount = ViewBag.AllCount as int? ?? Model?.Count() ?? 0;
    int lowCount = ViewBag.LowCount as int? ?? 0;
    int outCount = ViewBag.OutCount as int? ?? 0;
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Kho vận &amp; Tồn kho · Realtime</span>
            <h2>Quản lý Tồn kho &amp; Cảnh báo hết hàng</h2>
            <p class="small muted">Chuyên trách kiểm kê và cập nhật số lượng tồn kho cho từng biến thể màu sắc &amp; kích cỡ của gọng kính.</p>
        </div>
        <div style="display:flex; gap:10px; align-items:center;">
            <span class="badge" style="background:#f1f5f9; color:#334155; padding:6px 12px; font-size:13px; font-weight:600;">
                Tổng biến thể: @allCount
            </span>
            @if (lowCount > 0)
            {
                <span class="badge" style="background:#fef3c7; color:#92400e; padding:6px 12px; font-size:13px; font-weight:600;">
                    ⚠ Sắp hết: @lowCount
                </span>
            }
            @if (outCount > 0)
            {
                <span class="badge" style="background:#fee2e2; color:#dc2626; padding:6px 12px; font-size:13px; font-weight:600;">
                    ✕ Hết hàng: @outCount
                </span>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- THANH TÌM KIẾM & BỘ LỌC TỒN KHO -->
    <form method="get" asp-controller="AdminInventory" asp-action="Index" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-bottom:16px;">
        <div style="display:flex; gap:8px; align-items:center; flex:1; max-width:420px;">
            <input type="text" name="search" value="@searchKeyword" placeholder="Tìm theo tên mẫu kính, SKU, màu sắc..." style="width:100%; height:36px; padding:0 14px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; box-sizing:border-box;" />
            <input type="hidden" name="filter" value="@currentFilter" />
            <button type="submit" class="admin-btn-action btn-primary-action" style="height:36px !important;">Tìm kiếm</button>
            @if (!string.IsNullOrEmpty(searchKeyword) || currentFilter != "all")
            {
                <a asp-controller="AdminInventory" asp-action="Index" class="admin-btn-action" style="height:36px !important; text-decoration:none;" title="Đặt lại bộ lọc">↺ Đặt lại</a>
            }
        </div>

        <!-- Các tab lọc tình trạng -->
        <div style="display:flex; gap:6px; align-items:center;">
            <a asp-controller="AdminInventory" asp-action="Index" asp-route-search="@searchKeyword" asp-route-filter="all" 
               class="admin-btn-action @(currentFilter == "all" || string.IsNullOrEmpty(currentFilter) ? "btn-primary-action" : "")">
                Tất cả (@allCount)
            </a>
            <a asp-controller="AdminInventory" asp-action="Index" asp-route-search="@searchKeyword" asp-route-filter="low" 
               class="admin-btn-action @(currentFilter == "low" ? "btn-primary-action" : "")">
                Sắp hết hàng (&le; 3)
            </a>
            <a asp-controller="AdminInventory" asp-action="Index" asp-route-search="@searchKeyword" asp-route-filter="out" 
               class="admin-btn-action @(currentFilter == "out" ? "btn-primary-action" : "")">
                Hết hàng (0)
            </a>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th style="width: 70px;">Ảnh</th>
                    <th>Mẫu gọng kính</th>
                    <th>Mã SKU</th>
                    <th>Màu sắc &amp; Kích cỡ</th>
                    <th>Tình trạng</th>
                    <th style="width: 120px;">Tồn kho hiện tại</th>
                    <th style="width: 200px;">Cập nhật tồn kho</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var v in Model)
                    {
                        var img = v.Images?.FirstOrDefault()?.ImageUrl 
                                  ?? v.Product?.Images?.FirstOrDefault(i => i.IsPrimary)?.ImageUrl 
                                  ?? v.Product?.Images?.FirstOrDefault()?.ImageUrl 
                                  ?? "/images/products/p1.png";
                        bool isLow = v.StockQty > 0 && v.StockQty <= 3;
                        bool isOut = v.StockQty == 0;

                        <tr>
                            <td>
                                <img src="@img" alt="@v.Product?.ProductName" style="width: 48px; height: 48px; object-fit: contain; background: #fff; border-radius: 6px; border: 1px solid #e2e8f0;" />
                            </td>
                            <td>
                                <strong>@(v.Product?.Brand?.BrandName ?? "MIARA") - @(v.Product?.ProductName ?? v.Product?.ProductCode)</strong>
                            </td>
                            <td><code>@v.Sku</code></td>
                            <td>
                                <span>@v.ColorName</span> &bull; <span class="badge" style="background:#f1f5f9; color:#334155;">Size @v.SizeLabel</span>
                            </td>
                            <td>
                                @if (isOut)
                                {
                                    <span class="status-badge status-badge--cancelled">Hết hàng</span>
                                }
                                else if (isLow)
                                {
                                    <span class="status-badge status-badge--pending">Sắp hết hàng</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--completed">Còn hàng</span>
                                }
                            </td>
                            <td>
                                <strong style="font-size: 15px; color: #0f172a;">@v.StockQty</strong>
                                <span style="font-size: 12px; color: #64748b;">chiếc</span>
                            </td>
                            <td>
                                <form asp-controller="AdminInventory" asp-action="UpdateStock" method="post" class="admin-table-actions" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="variantId" value="@v.VariantId" />
                                    <input type="number" 
                                           name="newStock" 
                                           value="@v.StockQty" 
                                           min="0" 
                                           max="9999" 
                                           style="width: 75px; height: 32px; padding: 0 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 700; font-size: 13px; text-align: center;" />
                                    <button type="submit" class="admin-btn-action btn-primary-action" title="Lưu số lượng tồn kho mới">Lưu tồn kho</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="empty-text">Không tìm thấy dữ liệu tồn kho nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- TÁI SỬ DỤNG FILE PHÂN TRANG DÙNG CHUNG (REUSABLE PAGINATION) -->
    @if (pagination != null)
    {
        @await Html.PartialAsync("_Pagination", pagination)
    }
</div>
