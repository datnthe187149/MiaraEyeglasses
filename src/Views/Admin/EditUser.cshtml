@model MiaraEyeglasses.Models.Entities.User
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản: " + Model.FullName;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as IEnumerable<MiaraEyeglasses.Models.Entities.Role> ?? Enumerable.Empty<MiaraEyeglasses.Models.Entities.Role>();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">QUẢN TRỊ NGƯỜI DÙNG · CHỈNH SỬA TÀI KHOẢN</span>
            <h2>Chỉnh sửa thông tin: @Model.FullName</h2>
            <p class="small muted">Cập nhật thông tin định danh, số điện thoại, đổi vai trò phân quyền hoặc thiết lập lại mật khẩu đăng nhập.</p>
        </div>
        <div style="display: flex; gap: 10px;">
            <a asp-controller="AdminUser" asp-action="Details" asp-route-id="@Model.UserId" class="button button-outline small-btn">Xem chi tiết</a>
            <a asp-controller="AdminUser" asp-action="Index" class="button button-outline small-btn">← Danh sách tài khoản</a>
        </div>
    </div>

    <!-- Form Chỉnh sửa Người dùng -->
    <form class="customer-form sub-panel-form" asp-controller="AdminUser" asp-action="Edit" asp-route-id="@Model.UserId" method="post" style="margin-top: 20px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.UserId" />

        <div class="form-grid-2">
            <label>
                <span>Họ và tên *</span>
                <input type="text" name="fullName" value="@Model.FullName" required placeholder="VD: Nguyễn Văn A" />
            </label>
            <label>
                <span>Email đăng nhập (Cố định)</span>
                <input type="email" value="@Model.Email" disabled style="background: #f1f5f9; cursor: not-allowed;" />
            </label>
            <label>
                <span>Số điện thoại liên hệ</span>
                <input type="tel" name="phone" value="@Model.Phone" placeholder="0912345678" />
            </label>
            <label>
                <span>Vai trò phân quyền *</span>
                <select name="roleId">
                    @foreach (var r in roles)
                    {
                        if (r.RoleId == Model.RoleId)
                        {
                            <option value="@r.RoleId" selected>@r.RoleName</option>
                        }
                        else
                        {
                            <option value="@r.RoleId">@r.RoleName</option>
                        }
                    }
                </select>
            </label>
            <label>
                <span>Giới tính</span>
                <select name="gender">
                    <!option value="Nam" @(Model.Gender == "Nam" ? "selected" : "")>Nam</!option>
                    <!option value="Nữ" @(Model.Gender == "Nữ" ? "selected" : "")>Nữ</!option>
                    <!option value="Khác" @(Model.Gender == "Khác" ? "selected" : "")>Khác</!option>
                </select>
            </label>
            <label>
                <span>Ngày sinh</span>
                <input type="date" name="birthDateStr" value="@(Model.BirthDate.HasValue ? Model.BirthDate.Value.ToString("yyyy-MM-dd") : "")" />
            </label>
        </div>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; margin-top: 16px;">
            <h4 style="margin: 0 0 8px 0; color: #0f172a;">Thiết lập lại mật khẩu đăng nhập (Tùy chọn)</h4>
            <p class="small muted" style="margin-bottom: 12px;">Nếu không muốn đổi mật khẩu cho người dùng này, vui lòng để trống ô bên dưới.</p>
            <label style="margin: 0;">
                <span>Mật khẩu mới (Tối thiểu 6 ký tự)</span>
                <input type="password" name="newPassword" placeholder="Nhập mật khẩu mới nếu cần đổi..." style="margin-top: 6px; max-width: 400px;" />
            </label>
        </div>

        <div style="margin-top: 16px;">
            <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                <input type="checkbox" name="isActive" value="true" @(Model.IsActive ? "checked" : "") />
                <span style="font-weight: 600;">Cho phép tài khoản này đăng nhập và hoạt động trong hệ thống</span>
            </label>
        </div>

        <div style="display: flex; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e2e8f0;">
            <button type="submit" class="button" style="padding: 10px 24px; font-weight: 600;">✓ Lưu cập nhật tài khoản</button>
            <a asp-controller="AdminUser" asp-action="Index" class="button button-outline" style="padding: 10px 20px;">Hủy bỏ</a>
        </div>
    </form>
</div>
