@model MiaraEyeglasses.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng — MIARA";
}

<div class="view-section">
    <section class="container checkout-page">
        <nav class="breadcrumb" aria-label="Đường dẫn">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>/</span>
            <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
            <span>/</span>
            <span aria-current="page">Thanh toán</span>
        </nav>

        <div class="page-intro" data-reveal style="margin-bottom: 24px;">
            <span class="eyebrow">Xác nhận giao hàng · Orders / Payments</span>
            <h1>Thanh toán đơn hàng.</h1>
            <p>Vui lòng kiểm tra kỹ thông tin người nhận và lựa chọn phương thức thanh toán.</p>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">@TempData["ErrorMessage"]</div>
        }

        <form asp-controller="Order" asp-action="PlaceOrder" method="post">
            @Html.AntiForgeryToken()

            <div class="checkout-layout" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start;">
                <!-- Cột thông tin người nhận -->
                <div class="portal-card" data-reveal style="background: #fff; padding: 28px; border-radius: 12px; border: 1px solid var(--color-border, #e2e8f0);">
                    <h2 style="font-size: 20px; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">1. Thông tin nhận hàng</h2>
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 16px; color: #ef4444;"></div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="RecipientName" style="display: block; font-weight: 500; margin-bottom: 6px; font-size: 14px;">Họ và tên người nhận (*)</label>
                        <input asp-for="RecipientName" required placeholder="Ví dụ: Nguyễn Văn A" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
                        <span asp-validation-for="RecipientName" style="color: #ef4444; font-size: 12px;"></span>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="Phone" style="display: block; font-weight: 500; margin-bottom: 6px; font-size: 14px;">Số điện thoại liên hệ (*)</label>
                        <input asp-for="Phone" required placeholder="Ví dụ: 0912345678" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
                        <span asp-validation-for="Phone" style="color: #ef4444; font-size: 12px;"></span>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="ShippingAddress" style="display: block; font-weight: 500; margin-bottom: 6px; font-size: 14px;">Địa chỉ nhận hàng chi tiết (*)</label>
                        <input asp-for="ShippingAddress" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;" />
                        <span asp-validation-for="ShippingAddress" style="color: #ef4444; font-size: 12px;"></span>
                    </div>

                    <div style="margin-bottom: 24px;">
                        <label asp-for="OrderNote" style="display: block; font-weight: 500; margin-bottom: 6px; font-size: 14px;">Ghi chú đơn hàng (Tùy chọn)</label>
                        <textarea asp-for="OrderNote" rows="3" placeholder="Ví dụ: Giao giờ hành chính, dặn dò thợ kỹ thuật cắt tròng..." style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px;"></textarea>
                    </div>

                    <h2 style="font-size: 20px; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 10px;">2. Phương thức thanh toán</h2>
                    <div class="payment-methods" style="display: flex; flex-direction: column; gap: 12px;">
                        <label style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 1px solid #86efac; border-radius: 10px; cursor: pointer; background: #f0fdf4;">
                            <input type="radio" asp-for="PaymentMethod" value="DIRECT" checked style="width: 18px; height: 18px;" />
                            <div>
                                <strong style="color: #166534; font-size: 15px;">✓ Mua hàng &amp; Xác nhận thanh toán thành công ngay</strong>
                                <div class="small muted" style="color: #15803d; font-size: 12px; margin-top: 2px;">Đơn hàng sẽ được xác nhận đã thanh toán thành công ngay lập tức mà không cần qua cổng trung gian.</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: center; gap: 14px; padding: 16px; border: 1px solid #cbd5e1; border-radius: 10px; cursor: pointer; background: #f8fafc;">
                            <input type="radio" asp-for="PaymentMethod" value="VNPAY" style="width: 18px; height: 18px;" />
                            <div>
                                <strong style="font-size: 15px; color: var(--navy, #1e293b);">Cổng thanh toán điện tử VNPAY (Sandbox)</strong>
                                <div class="small muted" style="color: var(--muted, #64748b); font-size: 12px; margin-top: 2px;">Tùy chọn thanh toán qua mã QR hoặc thẻ ngân hàng thử nghiệm.</div>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- Cột tóm tắt đơn hàng -->
                <aside class="order-summary" data-reveal style="background: #fff; padding: 24px; border-radius: 12px; border: 1px solid var(--color-border, #e2e8f0);">
                    <h2 style="font-size: 20px; margin-bottom: 16px;">3. Đơn hàng (@Model.Cart.Items.Count(i => i.IsSelected) món)</h2>

                    <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
                        @foreach (var item in Model.Cart.Items.Where(i => i.IsSelected))
                        {
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 14px;">
                                <div>
                                    <strong style="color: var(--navy, #1e293b);">@item.ProductName (x@item.Quantity)</strong>
                                    <div class="small muted" style="font-size: 12px; color: var(--muted, #64748b);">@item.ColorName | @item.SizeLabel | @item.LensName</div>
                                </div>
                                <span style="font-weight: 600;">@item.LineTotal.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>

                    <div style="border-top: 1px solid #f1f5f9; padding-top: 12px; margin-bottom: 12px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                            <span class="muted">Tạm tính:</span>
                            <strong>@Model.Cart.Subtotal.ToString("N0") ₫</strong>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                            <span class="muted">Mã giảm giá (@(Model.Cart.AppliedCouponCode ?? "Không")):</span>
                            <span style="color: #16a34a; font-weight: 600;">-@Model.Cart.DiscountAmount.ToString("N0") ₫</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px;">
                            <span class="muted">Phí vận chuyển:</span>
                            <span>@(Model.Cart.ShippingFee == 0 ? "Miễn phí" : Model.Cart.ShippingFee.ToString("N0") + " ₫")</span>
                        </div>
                    </div>

                    <div class="summary-total" style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 16px; margin-bottom: 24px;">
                        <span style="font-weight: 600; font-size: 16px;">Tổng thanh toán:</span>
                        <strong style="color: #dc2626; font-size: 22px;">@Model.Cart.TotalAmount.ToString("N0") ₫</strong>
                    </div>

                    <button type="submit" class="button" style="width: 100%; padding: 14px; font-size: 16px; text-align: center;">
                        Xác nhận đặt hàng &amp; Thanh toán →
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="text-link" style="margin-top: 12px; display: block; text-align: center; text-decoration: none; font-size: 13px;">
                        ← Quay lại giỏ hàng
                    </a>
                </aside>
            </div>
        </form>
    </section>
</div>
