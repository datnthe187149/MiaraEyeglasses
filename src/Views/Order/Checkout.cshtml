@model MiaraEyeglasses.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng — MIARA";
}

@section Styles {
<style>
    /* Reset & chuẩn hóa cho khung tóm tắt đơn hàng */
    .checkout-summary-box {
        display: flex !important;
        flex-direction: column !important;
        width: 100% !important;
        gap: 0 !important;
        margin: 0 !important;
    }
    .summary-fee-list {
        display: flex !important;
        flex-direction: column !important;
        gap: 10px !important;
        width: 100% !important;
        padding-top: 16px !important;
        border-top: 1px solid #f1f5f9 !important;
        margin-top: 16px !important;
        margin-bottom: 16px !important;
    }
    .summary-row {
        display: flex !important;
        flex-direction: row !important;
        justify-content: space-between !important;
        align-items: center !important;
        width: 100% !important;
        font-size: 14px !important;
        color: #475569 !important;
        line-height: 1.4 !important;
    }
    .summary-row strong, .summary-row span.val {
        font-weight: 600 !important;
        color: #0f172a !important;
        text-align: right !important;
    }
    .summary-total-row {
        display: flex !important;
        flex-direction: row !important;
        justify-content: space-between !important;
        align-items: center !important;
        width: 100% !important;
        padding-top: 16px !important;
        border-top: 1px dashed #cbd5e1 !important;
        margin-bottom: 24px !important;
    }

    /* Nút tăng giảm số lượng sản phẩm tại Checkout */
    .qty-control-box {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        padding: 2px 4px;
    }
    .btn-qty-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
        background: #ffffff;
        color: #0f172a;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition: all .15s ease;
        padding: 0;
        line-height: 1;
    }
    .btn-qty-action:hover {
        background: #286598;
        border-color: #286598;
        color: #ffffff;
    }
    .btn-delete-item {
        border: none;
        background: transparent;
        color: #ef4444;
        font-size: 12px;
        cursor: pointer;
        padding: 2px 4px;
        margin-left: 6px;
        text-decoration: underline;
        transition: color .15s;
    }
    .btn-delete-item:hover {
        color: #b91c1c;
    }
</style>
}

<div class="view-section" style="padding-top: 16px;">
    <section class="container checkout-page">
        <nav class="breadcrumb" aria-label="Đường dẫn" style="margin-bottom: 8px;">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <span>/</span>
            <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
            <span>/</span>
            <span aria-current="page">Thanh toán</span>
        </nav>

        <!-- Tiêu đề tinh gọn, chữ bé, không chiếm nhiều dòng -->
        <div style="margin-bottom: 18px;">
            <h1 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0;">Thanh toán đơn hàng</h1>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-controller="Order" asp-action="PlaceOrder" method="post" id="checkout-form">
            @Html.AntiForgeryToken()
            <!-- Tự động thanh toán qua VNPAY Sandbox -->
            <input type="hidden" name="PaymentMethod" value="VNPAY" />

            <div class="checkout-layout" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: start;">
                <!-- CỘT BÊN TRÁI: THÔNG TIN GIAO HÀNG -->
                <div class="portal-card" data-reveal style="background: #fff; padding: 24px; border-radius: 12px; border: 1px solid var(--color-border, #e2e8f0);">
                    <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px; color: #0f172a;">
                        1. Thông tin nhận hàng
                    </h2>
                    <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom: 16px; color: #ef4444;"></div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="RecipientName" style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; color: #334155;">Họ và tên người nhận (*)</label>
                        <input asp-for="RecipientName" required placeholder="Nhập họ và tên người nhận kính" style="width: 100%; height: 42px; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;" />
                        <span asp-validation-for="RecipientName" style="color: #ef4444; font-size: 12px;"></span>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="Phone" style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; color: #334155;">Số điện thoại liên hệ (*)</label>
                        <input asp-for="Phone" required placeholder="Nhập số điện thoại nhận hàng (VD: 0912345678)" style="width: 100%; height: 42px; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;" />
                        <span asp-validation-for="Phone" style="color: #ef4444; font-size: 12px;"></span>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="ShippingAddress" style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; color: #334155;">Địa chỉ nhận hàng chi tiết (*)</label>
                        <input asp-for="ShippingAddress" required placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" style="width: 100%; height: 42px; padding: 0 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;" />
                        <span asp-validation-for="ShippingAddress" style="color: #ef4444; font-size: 12px;"></span>
                    </div>

                    <div style="margin-bottom: 16px;">
                        <label asp-for="OrderNote" style="display: block; font-weight: 600; margin-bottom: 6px; font-size: 14px; color: #334155;">Ghi chú đơn hàng (Tùy chọn)</label>
                        <textarea asp-for="OrderNote" rows="3" placeholder="Ví dụ: Giao giờ hành chính, gọi trước khi giao, dặn dò thợ kỹ thuật cắt tròng..." style="width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box;"></textarea>
                    </div>

                    <div style="background: #f0f7ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: 12px 16px; font-size: 13px; color: #1e40af; display: flex; align-items: center; gap: 8px;">
                        <span>💳</span>
                        <span>Đơn hàng sẽ tự động chuyển tiếp tới cổng thanh toán trực tuyến <strong>VNPAY (Sandbox)</strong> để hoàn tất thanh toán.</span>
                    </div>
                </div>

                <!-- CỘT BÊN PHẢI: TÓM TẮT ĐƠN HÀNG VÀ CHỈNH SỬA SỐ LƯỢNG SẢN PHẨM -->
                <aside class="order-summary" data-reveal style="background: #fff; padding: 24px; border-radius: 12px; border: 1px solid var(--color-border, #e2e8f0);">
                    <h2 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: #0f172a;">
                        2. Đơn hàng (@Model.Cart.Items.Count(i => i.IsSelected) món)
                    </h2>

                    <!-- Danh sách sản phẩm (có nút chỉnh sửa số lượng [-] [qty] [+], về 0 tự động xóa) -->
                    <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 16px; width: 100%;">
                        @foreach (var item in Model.Cart.Items.Where(i => i.IsSelected))
                        {
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; width: 100%;">
                                <div style="flex: 1; padding-right: 12px;">
                                    <strong style="color: var(--navy, #1e293b); font-size: 14px; display: block;">@item.ProductName</strong>
                                    <div style="font-size: 12px; color: #64748b; margin: 3px 0 8px 0; line-height: 1.4;">
                                        Phân loại: @item.ColorName | Size @item.SizeLabel | @item.LensName
                                    </div>

                                    <!-- Bộ điều khiển số lượng -->
                                    <div style="display: flex; align-items: center;">
                                        <div class="qty-control-box">
                                            <button type="button" 
                                                    class="btn-qty-action" 
                                                    onclick="changeCheckoutQty(@item.CartItemId, @(item.Quantity - 1))" 
                                                    title="Giảm số lượng (về 0 sẽ tự động xóa)">−</button>
                                            <span style="min-width: 22px; text-align: center; font-size: 13px; font-weight: 700; color: #0f172a;">@item.Quantity</span>
                                            <button type="button" 
                                                    class="btn-qty-action" 
                                                    onclick="changeCheckoutQty(@item.CartItemId, @(item.Quantity + 1))" 
                                                    title="Tăng số lượng">+</button>
                                        </div>
                                        <button type="button" 
                                                class="btn-delete-item" 
                                                onclick="changeCheckoutQty(@item.CartItemId, 0)" 
                                                title="Xóa sản phẩm này khỏi đơn hàng">
                                            Xóa
                                        </button>
                                    </div>
                                </div>
                                <span style="font-weight: 700; color: #0f172a; font-size: 15px; white-space: nowrap;">@item.LineTotal.ToString("N0") ₫</span>
                            </div>
                        }
                    </div>

                    <!-- KHỐI CHI PHÍ: MỖI MỤC HIỂN THỊ TRÊN 1 DÒNG RIÊNG BIỆT CỰC KỲ DỄ ĐỌC -->
                    <div class="checkout-summary-box">
                        <div class="summary-fee-list">
                            <!-- Dòng 1: Tạm tính -->
                            <div class="summary-row">
                                <span>Tạm tính tiền hàng:</span>
                                <strong class="val">@Model.Cart.Subtotal.ToString("N0") ₫</strong>
                            </div>

                            <!-- Dòng 2: Mã giảm giá -->
                            <div class="summary-row">
                                <span>Mã giảm giá (@(Model.Cart.AppliedCouponCode ?? "Không có")):</span>
                                <span class="val" style="color: #16a34a; font-weight: 700;">-@Model.Cart.DiscountAmount.ToString("N0") ₫</span>
                            </div>

                            <!-- Dòng 3: Phí vận chuyển -->
                            <div class="summary-row">
                                <span>Phí vận chuyển giao hàng:</span>
                                <span class="val" style="color: #2563eb; font-weight: 600;">
                                    @(Model.Cart.ShippingFee == 0 ? "Miễn phí" : Model.Cart.ShippingFee.ToString("N0") + " ₫")
                                </span>
                            </div>
                        </div>

                        <!-- Dòng 4: Tổng thanh toán -->
                        <div class="summary-total-row">
                            <span style="font-weight: 700; font-size: 16px; color: #0f172a;">Tổng thanh toán:</span>
                            <strong style="color: #dc2626; font-size: 24px; font-weight: 800;">@Model.Cart.TotalAmount.ToString("N0") ₫</strong>
                        </div>
                    </div>

                    <button type="submit" class="button" style="width: 100%; padding: 14px; font-size: 16px; text-align: center; font-weight: 700;">
                        Xác nhận đặt hàng &amp; Thanh toán →
                    </button>
                    <a asp-controller="Cart" asp-action="Index" class="text-link" style="margin-top: 14px; display: block; text-align: center; text-decoration: none; font-size: 13px; color: #64748b;">
                        ← Quay lại giỏ hàng
                    </a>
                </aside>
            </div>
        </form>
    </section>
</div>

@section Scripts {
<script>
    // Hàm thay đổi số lượng sản phẩm ngay tại trang thanh toán (nếu về 0 thì tự động xóa)
    function changeCheckoutQty(cartItemId, newQty) {
        if (newQty <= 0) {
            if (!confirm('Số lượng về 0, bạn có chắc chắn muốn xóa sản phẩm này khỏi đơn hàng?')) {
                return;
            }
        }

        var formData = new FormData();
        formData.append('cartItemId', cartItemId);
        formData.append('quantity', newQty);

        // Lấy verification token nếu có
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        if (tokenInput) {
            formData.append('__RequestVerificationToken', tokenInput.value);
        }

        fetch('/Cart/UpdateQuantity', {
            method: 'POST',
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            // Tự động tải lại trang để cập nhật lại tóm tắt đơn hàng và tổng tiền
            window.location.reload();
        })
        .catch(function(err) {
            console.error('Lỗi khi cập nhật số lượng:', err);
            window.location.reload();
        });
    }
</script>
}
