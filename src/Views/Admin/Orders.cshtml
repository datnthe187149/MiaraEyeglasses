@model IEnumerable<MiaraEyeglasses.Models.Entities.Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    byte? selectedStatus = ViewBag.SelectedStatus as byte?;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Đơn hàng trực tuyến · Orders</span>
            <h2>Quản lý Đơn hàng</h2>
            <p class="small muted">Theo dõi toàn bộ đơn hàng của khách, kiểm tra thông số đơn kính mắt và trạng thái thanh toán.</p>
        </div>
    </div>

    <!-- Bộ lọc trạng thái đơn hàng (Chỉ 3 trạng thái: Đang thanh toán, Đã thanh toán, Đã hủy) -->
    <form method="get" asp-controller="AdminOrder" asp-action="Index" class="admin-filter-row" asp-antiforgery="false">
        <label>
            <span>Lọc theo trạng thái</span>
            <select name="status" onchange="this.form.submit()">
                <option value="" selected="@(selectedStatus == null)">Tất cả trạng thái</option>
                <option value="0" selected="@(selectedStatus == 0)">Đang thanh toán</option>
                <option value="1" selected="@(selectedStatus == 1)">Đã thanh toán</option>
                <option value="5" selected="@(selectedStatus == 5)">Đã hủy</option>
            </select>
        </label>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Khách hàng &amp; SĐT</th>
                    <th>Đơn kính cận (SPH, CYL, AXIS, PD)</th>
                    <th>Tổng thanh toán</th>
                    <th>Trạng thái thanh toán</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var o in Model)
                    {
                        var payment = o.Payments?.FirstOrDefault();
                        var firstItem = o.Items?.FirstOrDefault();

                        string statusBadgeClass = "completed";
                        string statusText = "Đã thanh toán";

                        if (o.Status == 0)
                        {
                            statusBadgeClass = "pending";
                            statusText = "Đang thanh toán";
                        }
                        else if (o.Status == 5 || o.Status == 6)
                        {
                            statusBadgeClass = "cancelled";
                            statusText = "Đã hủy";
                        }

                        <tr>
                            <td>
                                <strong>#@o.OrderCode</strong><br />
                                <small class="muted">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                            </td>
                            <td>
                                <strong>@o.RecipientName</strong><br />
                                <small class="muted">SĐT: @o.Phone</small>
                            </td>
                            <td>
                                @if (firstItem != null && (firstItem.RightSph != null || firstItem.LeftSph != null))
                                {
                                    <div class="rx-mini-box">
                                        <strong>OD:</strong> @(firstItem.RightSph?.ToString("0.00") ?? "0.00") | @(firstItem.RightCyl?.ToString("0.00") ?? "0.00") | @(firstItem.RightAxis?.ToString() ?? "0")° · 
                                        <strong>OS:</strong> @(firstItem.LeftSph?.ToString("0.00") ?? "0.00") | @(firstItem.LeftCyl?.ToString("0.00") ?? "0.00") | @(firstItem.LeftAxis?.ToString() ?? "0")° · 
                                        <strong>PD:</strong> @(firstItem.PD?.ToString("0.0") ?? "62.0")mm
                                    </div>
                                }
                                else
                                {
                                    <div class="rx-mini-box">
                                        <small class="muted">Kính không độ (Thời trang)</small>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong style="color: #0284c7;">@o.TotalAmount.ToString("N0") ₫</strong>
                            </td>
                            <td>
                                <span class="status-badge status-badge--@statusBadgeClass">@statusText</span>
                            </td>
                            <td>
                                <a asp-controller="AdminOrder" asp-action="Detail" asp-route-id="@o.OrderId" class="button button-outline small-btn" style="text-decoration:none;">Xem chi tiết</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:32px; color:#64748b;">Không có đơn hàng nào phù hợp với bộ lọc.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
