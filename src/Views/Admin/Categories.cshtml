@model IEnumerable<MiaraEyeglasses.Models.Entities.Category>
@{
    ViewData["Title"] = "Quản lý Danh mục Gọng kính";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Phân loại sản phẩm · Categories</span>
            <h2>Quản lý Danh mục Gọng kính</h2>
            <p class="small muted">Quản lý các phân nhóm gọng kính (Nam, Nữ, Unisex, Càng kim loại, Nhựa Acetate, Titan...).</p>
        </div>
        <button type="button" class="button small-btn" onclick="openAddCategoryForm()">+ Thêm danh mục mới</button>
    </div>

    <!-- Form Thêm / Cập nhật Danh mục -->
    <form class="customer-form sub-panel-form" id="form-category-crud" hidden asp-controller="AdminCategory" asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="categoryId" id="crud-categoryId" value="" />
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
            <h3 style="margin:0" id="crud-category-title">Thêm Danh mục Mới</h3>
            <button type="button" class="text-button" onclick="document.getElementById('form-category-crud').setAttribute('hidden','')">✕ Đóng form</button>
        </div>
        <div class="form-grid-2">
            <label>
                <span>Tên danh mục *</span>
                <input type="text" name="categoryName" id="crud-categoryName" required placeholder="VD: Gọng kính Titan cao cấp" />
            </label>
            <label>
                <span>Đường dẫn định danh (Slug)</span>
                <input type="text" name="slug" id="crud-slug" placeholder="VD: gong-kinh-titan (bỏ trống tự tạo)" />
            </label>
        </div>
        <div style="display:flex; gap:12px; margin-top:12px">
            <button type="submit" class="button" id="crud-category-btn">Lưu danh mục</button>
            <button type="button" class="button button-outline" onclick="openAddCategoryForm()">Hủy chỉnh sửa</button>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Tên danh mục</th>
                    <th>Đường dẫn định danh (Slug)</th>
                    <th>Số lượng mẫu kính</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.CategoryName</strong></td>
                            <td><code>@c.Slug</code></td>
                            <td>
                                <span class="badge" style="background:#f1f5f9; color:#334155; font-weight:600; padding:4px 8px; border-radius:6px">
                                    @(c.Products?.Count ?? 0) mẫu
                                </span>
                            </td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="status-badge status-badge--completed">Đang hiển thị</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--cancelled">Đã ẩn</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex; gap:8px; align-items:center;">
                                    <button type="button" 
                                            class="button button-outline small-btn" 
                                            onclick="editCategory(@c.CategoryId, '@(c.CategoryName.Replace("'", "\\'"))', '@(c.Slug?.Replace("'", "\\'") ?? "")')">
                                        Chỉnh sửa
                                    </button>
                                    <form asp-controller="AdminCategory" asp-action="ToggleActive" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                        <button type="submit" class="text-button @(c.IsActive ? "danger-text" : "")">
                                            @(c.IsActive ? "Ẩn" : "Hiện")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="empty-text">Chưa có danh mục nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function openAddCategoryForm() {
        var form = document.getElementById('form-category-crud');
        form.action = '/Admin/Categories/Add';
        document.getElementById('crud-category-title').innerText = 'Thêm Danh mục Mới';
        document.getElementById('crud-category-btn').innerText = 'Lưu danh mục mới';
        document.getElementById('crud-categoryId').value = '';
        document.getElementById('crud-categoryName').value = '';
        document.getElementById('crud-slug').value = '';
        form.removeAttribute('hidden');
        document.getElementById('crud-categoryName').focus();
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function editCategory(id, name, slug) {
        var form = document.getElementById('form-category-crud');
        form.action = '/Admin/Categories/Update';
        document.getElementById('crud-category-title').innerText = 'Chỉnh sửa Danh mục: ' + name;
        document.getElementById('crud-category-btn').innerText = 'Cập nhật thay đổi';
        document.getElementById('crud-categoryId').value = id;
        document.getElementById('crud-categoryName').value = name;
        document.getElementById('crud-slug').value = slug;
        form.removeAttribute('hidden');
        document.getElementById('crud-categoryName').focus();
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
</script>
