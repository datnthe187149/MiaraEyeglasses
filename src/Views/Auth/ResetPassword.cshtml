@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    string? email = ViewBag.Email as string ?? Context.Session.GetString("EmailForgot");
}

<div class="view-section">
  <section class="container section customer-page">
    <div class="page-intro" data-reveal>
      <span class="eyebrow">Bảo mật tài khoản</span>
      <h1>Tạo mật khẩu mới</h1>
      <p>
        Thiết lập mật khẩu mới cho tài khoản:
        <strong style="color: #286598;">@(string.IsNullOrEmpty(email) ? "của bạn" : email)</strong>
      </p>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" style="max-width: 480px; margin: 0 auto 20px auto; padding: 12px 16px; background: #fef2f2; color: #dc2626; border: 1px solid #fee2e2; border-radius: 8px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span>@ViewBag.Error</span>
        </div>
    }

    <form class="customer-form" action="/reset-password" method="post" data-reveal>
      @Html.AntiForgeryToken()

      <label>
        Mật khẩu mới *
        <input name="newPassword" type="password" autocomplete="new-password" minlength="6" required placeholder="Tối thiểu 6 ký tự" />
      </label>

      <label>
        Xác nhận mật khẩu mới *
        <input name="confirmPassword" type="password" autocomplete="new-password" minlength="6" required placeholder="Nhập lại mật khẩu mới" />
      </label>

      <button class="button" type="submit" style="margin-top: 14px; width: 100%;">
        Lưu mật khẩu mới
      </button>

      <p style="text-align: center; margin-top: 16px;">
        <a href="/login" style="font-weight: 600; text-decoration: underline;">Quay lại Đăng nhập</a>
      </p>
    </form>
  </section>
</div>
