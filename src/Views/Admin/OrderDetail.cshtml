@model MiaraEyeglasses.Models.Entities.Order
@{
    ViewData["Title"] = "Chi tiết Đơn hàng #" + Model.OrderCode;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    string statusBadgeClass = "completed";
    string statusText = "Đã thanh toán";

    if (Model.Status == 0)
    {
        statusBadgeClass = "pending";
        statusText = "Đang thanh toán";
    }
    else if (Model.Status == 5 || Model.Status == 6)
    {
        statusBadgeClass = "cancelled";
        statusText = "Đã hủy";
    }

    var payment = Model.Payments?.FirstOrDefault();
    string paymentMethod = "COD (Thanh toán khi nhận hàng)";
    if (payment != null && !string.IsNullOrEmpty(payment.Method))
    {
        if (payment.Method == "VNPAY")
        {
            paymentMethod = "Cổng thanh toán điện tử VNPay";
        }
        else
        {
            paymentMethod = payment.Method;
        }
    }
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">QUẢN LÝ ĐƠN HÀNG · CHI TIẾT ĐƠN HÀNG</span>
            <h2>Đơn hàng #@Model.OrderCode</h2>
            <p class="small muted">Ngày đặt hàng: <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</strong></p>
        </div>
        <div style="display: flex; gap: 12px; align-items: center;">
            <span class="status-badge status-badge--@statusBadgeClass" style="font-size: 14px; padding: 6px 14px;">@statusText</span>
            <a asp-controller="AdminOrder" asp-action="Index" class="button button-outline small-btn">← Quay lại danh sách Đơn hàng</a>
        </div>
    </div>

    <!-- Hàng thông tin giao nhận & thanh toán -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px; margin-bottom: 24px;">
        <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h3 style="margin-top: 0; font-size: 16px; color: #1e293b; border-bottom: 1px solid #cbd5e1; padding-bottom: 8px;">1. Thông tin Người nhận &amp; Giao hàng</h3>
            <p style="margin: 8px 0;">Người nhận: <strong>@Model.RecipientName</strong></p>
            <p style="margin: 8px 0;">Số điện thoại: <strong>@Model.Phone</strong></p>
            <p style="margin: 8px 0;">Địa chỉ giao hàng: <strong>@Model.ShippingAddress</strong></p>
            @if (!string.IsNullOrEmpty(Model.OrderNote))
            {
                <div style="margin-top: 12px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 6px; padding: 10px; color: #92400e;">
                    <strong>Ghi chú đơn hàng:</strong> @Model.OrderNote
                </div>
            }
        </div>

        <div style="background: #f8fafc; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h3 style="margin-top: 0; font-size: 16px; color: #1e293b; border-bottom: 1px solid #cbd5e1; padding-bottom: 8px;">2. Tóm tắt Chi phí &amp; Thanh toán</h3>
            <div style="display: flex; justify-content: space-between; margin: 8px 0;">
                <span>Tiền hàng (Gọng &amp; Tròng):</span>
                <strong>@Model.Subtotal.ToString("N0") ₫</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin: 8px 0;">
                <span>Giảm giá khuyến mãi:</span>
                <strong style="color: #059669;">-@Model.DiscountAmount.ToString("N0") ₫</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin: 8px 0;">
                <span>Phí vận chuyển:</span>
                <strong>@Model.ShippingFee.ToString("N0") ₫</strong>
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 12px; padding-top: 12px; border-top: 1px dashed #cbd5e1; font-size: 18px;">
                <span>Tổng số tiền:</span>
                <strong style="color: #0284c7;">@Model.TotalAmount.ToString("N0") ₫</strong>
            </div>
            <div style="margin-top: 12px; font-size: 13px; color: #64748b;">
                Phương thức: <strong>@paymentMethod</strong>
                @if (payment != null && !string.IsNullOrEmpty(payment.TransactionRef))
                {
                    <br /><span>Mã giao dịch: <code>@payment.TransactionRef</code></span>
                }
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm trong đơn & Thông số khúc xạ -->
    <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;">
        <h3 style="margin-top: 0; margin-bottom: 16px; font-size: 18px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px;">
            3. Chi tiết sản phẩm &amp; Thông số khúc xạ đơn kính
        </h3>

        @if (Model.Items != null && Model.Items.Any())
        {
            <div style="display: grid; gap: 16px;">
                @foreach (var item in Model.Items)
                {
                    <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; background: #fafafa;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                            <div>
                                <h4 style="margin: 0 0 4px 0; font-size: 16px; color: #0f172a;">@item.ProductName</h4>
                                <div class="small muted">
                                    Phân loại: <strong>@(item.ColorName ?? "Tiêu chuẩn")</strong> · Kích cỡ: <strong>Size @(item.SizeLabel ?? "M")</strong> · Mã SKU: <code>@(item.Sku ?? "—")</code>
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <div style="font-size: 16px; font-weight: bold; color: #0284c7;">@item.LineTotal.ToString("N0") ₫</div>
                                <div class="small muted">Gọng: @item.FramePrice.ToString("N0") ₫ · SL: x@item.Quantity</div>
                            </div>
                        </div>

                        <!-- Gói tròng kính -->
                        @if (!string.IsNullOrEmpty(item.LensName))
                        {
                            <div style="background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 6px; padding: 10px 14px; margin-bottom: 10px;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div>
                                        <strong style="color: #1e40af;">Gói tròng kính:</strong>
                                        <span style="color: #1e3a8a;">@item.LensName</span>
                                    </div>
                                    <strong style="color: #1e40af;">+@item.LensPrice.ToString("N0") ₫</strong>
                                </div>
                            </div>
                        }

                        <!-- Thông số khúc xạ đo mắt -->
                        @if (item.RightSph != null || item.LeftSph != null)
                        {
                            <div style="background: #f1f5f9; border-radius: 6px; padding: 12px; font-size: 13px;">
                                <div style="font-weight: 600; color: #334155; margin-bottom: 6px;">Thông số đơn kính mắt:</div>
                                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px;">
                                    <div>
                                        <strong>Mắt phải (OD):</strong>
                                        Cầu: @(item.RightSph?.ToString("0.00") ?? "0.00") |
                                        Loạn: @(item.RightCyl?.ToString("0.00") ?? "0.00") |
                                        Trục: @(item.RightAxis?.ToString() ?? "0")°
                                    </div>
                                    <div>
                                        <strong>Mắt trái (OS):</strong>
                                        Cầu: @(item.LeftSph?.ToString("0.00") ?? "0.00") |
                                        Loạn: @(item.LeftCyl?.ToString("0.00") ?? "0.00") |
                                        Trục: @(item.LeftAxis?.ToString() ?? "0")°
                                    </div>
                                    <div>
                                        <strong>Khoảng cách đồng tử (PD):</strong>
                                        @(item.PD?.ToString("0.0") ?? "62.0") mm
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="small muted" style="padding: 4px 0;">Kính mẫu không độ (Gọng thời trang).</div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- Thanh nút hành động phía dưới -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e2e8f0;">
        <a asp-controller="AdminOrder" asp-action="Index" class="button button-outline" style="text-decoration: none;">← Quay lại danh sách Đơn hàng</a>
        <button type="button" class="button button-outline" onclick="window.print();">🖨 In đơn hàng</button>
    </div>
</div>
