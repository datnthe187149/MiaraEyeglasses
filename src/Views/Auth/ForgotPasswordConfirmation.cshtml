@model string
@{
    ViewData["Title"] = "Xác nhận gửi email đặt lại mật khẩu";
    string? directLink = ViewBag.DirectResetLink as string;
}

<div class="auth-page container">
    <div class="auth-card" style="text-align: center;">
        <div style="font-size: 48px; margin-bottom: 12px;">✉️</div>
        <h2>Kiểm tra hộp thư của bạn</h2>
        <p class="auth-subtitle">
            Hệ thống đã gửi hướng dẫn đặt lại mật khẩu đến địa chỉ:
            <br />
            <strong style="color: #286598; font-size: 16px;">@Model</strong>
        </p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success" style="text-align: left; margin: 16px 0; font-size: 14px;">
                @TempData["SuccessMessage"]
            </div>
        }

        @if (!string.IsNullOrEmpty(directLink))
        {
            <div style="background: #f1f5f9; padding: 16px; border-radius: 8px; margin: 20px 0; text-align: left; border: 1px dashed #94a3b8;">
                <p style="margin: 0 0 8px 0; font-size: 13px; font-weight: 600; color: #475569;">
                    🔗 Đường dẫn đặt lại mật khẩu trực tiếp (Dành cho kiểm thử / Demo):
                </p>
                <div style="margin: 10px 0; text-align: center;">
                    <a href="@directLink" class="btn btn-primary" style="display: inline-block; padding: 8px 20px; font-size: 14px; text-decoration: none;">
                        Mở trang Đặt lại mật khẩu ngay
                    </a>
                </div>
                <p style="font-size: 12px; color: #64748b; margin: 0; word-break: break-all;">
                    @directLink
                </p>
            </div>
        }

        <p class="small muted" style="margin-top: 20px;">
            Không nhận được email? Hãy kiểm tra thư mục Spam / Rác hoặc thử lại sau vài phút.
        </p>

        <div class="auth-switch" style="margin-top: 24px;">
            <a asp-action="Login" class="btn btn-outline">← Quay lại trang Đăng nhập</a>
        </div>
    </div>
</div>

