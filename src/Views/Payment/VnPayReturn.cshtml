@{
    ViewData["Title"] = "Kết quả thanh toán VNPay — MIARA";
    string result = ViewBag.Result as string ?? "";
    string message = ViewBag.Message as string ?? "";
    string txnRef = ViewBag.TxnRef as string ?? "";
    string amount = ViewBag.Amount as string ?? "";
    string txnNo = ViewBag.TransactionNo as string ?? "";
}

<div class="view-section">
    <div class="container" style="max-width: 640px; margin: 40px auto;">
        <div class="portal-card" style="text-align: center; padding: 40px 24px; background: #fff; border-radius: 16px; border: 1px solid var(--color-border, #e2e8f0);">
            @if (result == "SUCCESS")
            {
                <div style="width: 64px; height: 64px; background: #ecfdf5; border-radius: 50%; color: #10b981; font-size: 32px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">✓</div>
                <h1 style="font-size: 26px; margin-bottom: 8px; color: #166534;">Thanh toán thành công!</h1>
                <p class="muted" style="margin-bottom: 24px;">Giao dịch qua cổng VNPAY đã được hoàn tất và hệ thống đang xử lý đơn hàng của bạn.</p>
            }
            else
            {
                <div style="width: 64px; height: 64px; background: #fef2f2; border-radius: 50%; color: #ef4444; font-size: 32px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">✕</div>
                <h1 style="font-size: 26px; margin-bottom: 8px; color: #991b1b;">Thanh toán không thành công</h1>
                <p class="muted" style="margin-bottom: 24px;">@message</p>
            }

            <div style="background: #f8fafc; border-radius: 12px; padding: 20px; text-align: left; margin-bottom: 24px; font-size: 14px; line-height: 1.8;">
                <div>Mã đơn hàng tham chiếu: <strong style="color: var(--blue, #2563eb);">@txnRef</strong></div>
                @if (!string.IsNullOrEmpty(txnNo))
                {
                    <div>Mã giao dịch VNPAY: <strong>@txnNo</strong></div>
                }
                @if (!string.IsNullOrEmpty(amount) && long.TryParse(amount, out var rawAmt))
                {
                    <div style="border-top: 1px solid #e2e8f0; margin-top: 10px; padding-top: 10px; font-size: 16px;">
                        Số tiền giao dịch: <strong style="color: #dc2626;">@((rawAmt / 100).ToString("N0")) ₫</strong>
                    </div>
                }
            </div>

            <div style="display: flex; gap: 12px; justify-content: center;">
                <a asp-controller="UserOrder" asp-action="Index" class="button button-outline" style="text-decoration: none;">Xem đơn hàng của tôi</a>
                <a asp-controller="Home" asp-action="Index" class="button" style="text-decoration: none;">Về trang chủ</a>
            </div>
        </div>
    </div>
</div>
