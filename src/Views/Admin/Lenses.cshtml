@model IEnumerable<MiaraEyeglasses.Models.Entities.LensOption>
@{
    ViewData["Title"] = "Quản lý Tùy chọn Tròng kính";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" style="margin-bottom: 20px; padding: 12px 16px; background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; color: #065f46;">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin-bottom: 20px; padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; color: #991b1b;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="portal-card">
    <div class="portal-card-head">
        <div>
            <span class="eyebrow">Dịch vụ cắt kính · LensOptions</span>
            <h2>Quản lý Tùy chọn Tròng kính</h2>
            <p class="small muted">Cấu hình các gói tròng kính cận, viễn, loạn: chiết suất mỏng, chống tia UV, lọc ánh sáng xanh, đổi màu và đơn giá cộng thêm.</p>
        </div>
        <button type="button" class="button small-btn" onclick="openAddLensForm()">+ Thêm gói tròng kính mới</button>
    </div>

    <!-- Form Thêm / Cập nhật Gói Tròng kính -->
    <form class="sub-panel-form" id="form-lens-crud" hidden asp-controller="AdminLens" asp-action="Add" method="post" style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:12px; padding:20px; margin-bottom:24px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="lensOptionId" id="crud-lensOptionId" value="" />
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px">
            <h3 style="margin:0; font-size:16px; font-weight:700; color:#0f172a;" id="crud-lens-title">Thêm Gói Tròng kính Mới</h3>
            <button type="button" class="text-button" onclick="document.getElementById('form-lens-crud').setAttribute('hidden','')">✕ Đóng form</button>
        </div>
        <div class="form-grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:12px;">
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Tên gói tròng kính *</span>
                <input type="text" name="lensName" id="crud-lensName" required placeholder="VD: Tròng Chống Ánh Sáng Xanh BlueCut" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Chiết suất (Index) *</span>
                <input type="number" step="0.01" name="refractiveIndex" id="crud-refractiveIndex" required placeholder="VD: 1.56, 1.60, 1.67, 1.74" value="1.56" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Đơn giá cộng thêm (VNĐ) *</span>
                <input type="number" name="extraPrice" id="crud-extraPrice" required value="250000" min="0" step="10000" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
            <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600;">
                <span>Độ cận khuyến nghị</span>
                <input type="text" name="rxLimit" id="crud-rxLimit" placeholder="VD: Dưới 4 độ cận, loạn dưới 2 độ" style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
            </label>
        </div>
        <label style="display:flex; flex-direction:column; gap:6px; font-size:13px; font-weight:600; margin-bottom:14px;">
            <span>Tính năng nổi bật / Mô tả</span>
            <input type="text" name="description" id="crud-description" placeholder="Lọc ánh sáng xanh máy tính, chống trầy, giảm chói ban đêm..." style="padding:8px 12px; border:1px solid #cbd5e1; border-radius:6px;" />
        </label>
        <div style="display:flex; gap:10px;">
            <button type="submit" class="button small-btn" id="crud-lens-btn">Lưu gói tròng kính</button>
            <button type="button" class="button button-outline small-btn" onclick="openAddLensForm()">Hủy chỉnh sửa</button>
        </div>
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Tên gói tròng kính</th>
                    <th>Chiết suất</th>
                    <th>Đơn giá cộng thêm</th>
                    <th>Tính năng nổi bật</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var l in Model)
                    {
                        <tr>
                            <td><strong>@l.LensName</strong></td>
                            <td><span class="badge" style="background:#f1f5f9; color:#334155;">@l.RefractiveIndex.ToString("F2")</span></td>
                            <td><strong style="color:#286598;">@(l.ExtraPrice > 0 ? $"{l.ExtraPrice:N0} ₫" : "Miễn phí (0 ₫)")</strong></td>
                            <td>@(string.IsNullOrEmpty(l.Description) ? (l.RxLimit ?? "—") : l.Description)</td>
                            <td>
                                @if (l.IsActive)
                                {
                                    <span class="status-badge status-badge--completed">Đang phục vụ</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge--cancelled">Đã tạm dừng</span>
                                }
                            </td>
                            <td>
                                <div class="admin-table-actions">
                                    <button type="button" 
                                            class="admin-btn-action" 
                                            onclick="editLens(@l.LensOptionId, '@(l.LensName.Replace("'", "\\'"))', '@l.RefractiveIndex', @((long)l.ExtraPrice), '@(l.Description?.Replace("'", "\\'") ?? "")', '@(l.RxLimit?.Replace("'", "\\'") ?? "")')">
                                        Chỉnh sửa
                                    </button>
                                    <form asp-controller="AdminLens" asp-action="ToggleActive" method="post" style="display:inline; margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="lensOptionId" value="@l.LensOptionId" />
                                        <button type="submit" class="admin-btn-action @(l.IsActive ? "btn-toggle-off" : "btn-toggle-on")">
                                            @(l.IsActive ? "Tắt" : "Bật")
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-text">Chưa có gói tròng kính nào trong hệ thống.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function openAddLensForm() {
        var form = document.getElementById('form-lens-crud');
        form.action = '/Admin/Lenses/Add';
        document.getElementById('crud-lens-title').innerText = 'Thêm Gói Tròng kính Mới';
        document.getElementById('crud-lens-btn').innerText = 'Lưu gói tròng kính mới';
        document.getElementById('crud-lensOptionId').value = '';
        document.getElementById('crud-lensName').value = '';
        document.getElementById('crud-refractiveIndex').value = '1.56';
        document.getElementById('crud-extraPrice').value = '250000';
        document.getElementById('crud-rxLimit').value = '';
        document.getElementById('crud-description').value = '';
        form.removeAttribute('hidden');
        document.getElementById('crud-lensName').focus();
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function editLens(id, name, index, price, desc, limit) {
        var form = document.getElementById('form-lens-crud');
        form.action = '/Admin/Lenses/Update';
        document.getElementById('crud-lens-title').innerText = 'Chỉnh sửa Gói Tròng: ' + name;
        document.getElementById('crud-lens-btn').innerText = 'Cập nhật thay đổi';
        document.getElementById('crud-lensOptionId').value = id;
        document.getElementById('crud-lensName').value = name;
        document.getElementById('crud-refractiveIndex').value = index;
        document.getElementById('crud-extraPrice').value = price;
        document.getElementById('crud-description').value = desc;
        document.getElementById('crud-rxLimit').value = limit;
        form.removeAttribute('hidden');
        document.getElementById('crud-lensName').focus();
        form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
</script>
